rules_version = '2';
// Luật bảo mật Firestore cho Hành Trình CKTG:
// - saves/{uid}: mỗi người chỉ đọc/ghi được bản lưu của chính mình.
// - names/{khóa}: sổ tên đội. Ai đăng nhập cũng kiểm tra được 1 tên đã có chủ chưa,
//   chỉ được tạo tên mới cho chính mình; tên đã tạo không sửa, không xóa được
//   → tên đã có người đặt sẽ không bao giờ được đặt lại.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'name', 'level', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
    match /names/{key} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && key.matches('^[a-z0-9]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 20
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
