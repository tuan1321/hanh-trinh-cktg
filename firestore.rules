rules_version = '2';
// Luật bảo mật Firestore cho Hành Trình CKTG:
// - saves/{uid}: mỗi người chỉ đọc/ghi được bản lưu của chính mình.
// - names/{khóa}: sổ tên đội. Ai đăng nhập cũng kiểm tra được 1 tên đã có chủ chưa,
//   chỉ được tạo tên mới cho chính mình; tên đã tạo không sửa, không xóa được
//   → tên đã có người đặt sẽ không bao giờ được đặt lại.
// - activity/{uid}, daily/{ngày}: thống kê truy cập. Người chơi chỉ ghi được của mình, mỗi lần chỉ cộng
//   thêm một lượng nhỏ; chỉ quản trị viên (có tài liệu admins/{uid}) mới đọc được toàn bộ.
// - admins/{uid}: danh sách quản trị viên, chỉ tạo bằng tay trong Firebase Console.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function num(d, k) { return d.get(k, 0); }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /activity/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'level', 'device', 'first', 'last', 'lastDay', 'sessions', 'seconds'])
        && request.resource.data.sessions == 1
        && request.resource.data.seconds is int && request.resource.data.seconds <= 600
        && request.resource.data.last == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'level', 'device', 'first', 'last', 'lastDay', 'sessions', 'seconds'])
        && request.resource.data.first == resource.data.first
        && request.resource.data.sessions >= resource.data.sessions
        && request.resource.data.sessions <= resource.data.sessions + 1
        && request.resource.data.seconds >= resource.data.seconds
        && request.resource.data.seconds <= resource.data.seconds + 600
        && request.resource.data.last == request.time;
      allow delete: if false;
    }
    match /daily/{day} {
      allow read: if isAdmin();
      allow create: if signedIn() && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['sessions', 'users', 'seconds'])
        && num(request.resource.data, 'sessions') <= 1 && num(request.resource.data, 'users') <= 1
        && num(request.resource.data, 'seconds') <= 600;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['sessions', 'users', 'seconds'])
        && num(request.resource.data, 'sessions') >= num(resource.data, 'sessions')
        && num(request.resource.data, 'sessions') <= num(resource.data, 'sessions') + 1
        && num(request.resource.data, 'users') >= num(resource.data, 'users')
        && num(request.resource.data, 'users') <= num(resource.data, 'users') + 1
        && num(request.resource.data, 'seconds') >= num(resource.data, 'seconds')
        && num(request.resource.data, 'seconds') <= num(resource.data, 'seconds') + 600;
      allow delete: if false;
    }
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'name', 'level', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
    match /names/{key} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && key.matches('^[a-z0-9]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 20
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
