rules_version = '2';
// Luật bảo mật Firestore cho Hành Trình CKTG:
// mỗi người chỉ đọc/ghi được bản lưu của chính mình tại saves/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'name', 'level', 'updated'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
    }
  }
}
